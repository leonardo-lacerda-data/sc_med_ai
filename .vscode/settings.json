{
  // Interpretador do projeto. Sem isto o Pylance analisa o Python global,
  // não enxerga nada que está instalado no .venv, e sublinha todo import.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",

  // Faz o `from src import config` resolver a partir da raiz do projeto.
  "python.analysis.extraPaths": ["${workspaceFolder}"],
  "python.analysis.autoImportCompletions": true,

  // Terminal já abre com o venv ativo.
  "python.terminal.activateEnvironment": true,

  // Não sugerir conteúdo de arquivos de segredo nem de dados brutos.
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": true
  },
  "files.exclude": {
    "**/__pycache__": true
  },
  "files.watcherExclude": {
    "**/data/index/**": true
  }
}
